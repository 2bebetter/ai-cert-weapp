.page { padding: 0; height: 100vh; display: flex; flex-direction: column; }

.filter-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: var(--card-bg);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}
.filter-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 12px;
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 12px;
  color: var(--text-2);
}
.filter-btn .arrow { font-size: 8px; color: var(--text-4); }
.filter-info {
  margin-left: auto;
  font-size: 12px;
  color: var(--text-3);
}

.question-scroll {
  flex: 1;
  padding: 0 0 24px;
}

.question-card { margin: 12px 16px; }

.question-head {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 12px;
}
.question-level {
  font-size: 11px;
  color: var(--text-3);
  margin-right: auto;
}

/* 右上角图标操作区 */
.question-actions {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: auto;
}

/* 矢量图标基类 */
.head-icon {
  display: block;
  width: 24px;
  height: 24px;
  padding: 4px;
  box-sizing: content-box;
  background-size: 20px 20px;
  background-repeat: no-repeat;
  background-position: center;
  border-radius: 4px;
  transition: opacity 0.15s;
}
.head-icon:active {
  opacity: 0.4;
  background-color: rgba(0,0,0,0.04);
}

