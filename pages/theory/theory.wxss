.question-text {
  font-size: 15px;
  line-height: 1.7;
  color: var(--text-1);
  display: block;
  margin-bottom: 16px;
}

.options { margin-bottom: 12px; }

.option {
  display: flex;
  align-items: flex-start;
  padding: 12px 14px;
  margin: 6px 0;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--card-bg);
  font-size: 14px;
  line-height: 1.5;
}
.option:active { border-color: var(--primary); }
.option radio,
.option checkbox { margin-right: 10px; margin-top: 2px; flex-shrink: 0; }
.option.selected {
  border-color: var(--primary);
  background: var(--primary-light);
}
.option.selected .option-label { color: var(--primary); font-weight: 500; }
.option.correct { border-color: var(--success); background: #e8f8ee; }
.option.wrong { border-color: var(--danger); background: #ffe8e6; }

.submit-btn { margin-top: 8px; }

.feedback {
  padding: 12px 16px;
  border-radius: var(--radius-sm);
  margin-top: 12px;
}
.feedback.ok { background: #e8f8ee; }
.feedback.bad { background: #ffe8e6; }
.feedback-title {
  font-weight: 600;
  font-size: 14px;
  display: block;
  margin-bottom: 4px;
}
.feedback-body {
  font-size: 13px;
  line-height: 1.6;
  display: block;
}

.nav-bar {
  display: flex;
  justify-content: space-between;
  padding: 0 16px;
  margin-top: 12px;
}

/* 笔记弹窗 */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
}
.overlay.hidden { display: none; }
.note-modal {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 20px;
  width: 85%;
  max-width: 360px;
}
.note-modal-title {
  font-size: 16px;
  font-weight: 600;
  display: block;
  margin-bottom: 12px;
}
.note-textarea {
  width: 100%;
  min-height: 120px;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 14px;
  line-height: 1.6;
  box-sizing: border-box;
}
.note-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 12px;
}