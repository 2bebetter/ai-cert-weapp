<view class="page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载题库中…</text>
  </view>

  <!-- 加载失败 -->
  <view class="empty-state" wx:elif="{{loadError}}">
    <text>😵</text>
    <text>题库加载失败</text>
    <text class="placeholder">请检查网络或云存储配置</text>
    <button class="btn btn-primary" bindtap="retry" style="margin-top:16px">重新加载</button>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar" wx:else>
    <picker mode="selector" range="{{filterTypes}}" bindchange="onFilterTypeChange">
      <view class="filter-btn">
        <text>{{filterTypes[filterTypeIndex]}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
    <picker mode="selector" range="{{filterAnswers}}" bindchange="onFilterAnswerChange">
      <view class="filter-btn">
        <text>{{filterAnswers[filterAnswerIndex]}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
    <view class="filter-info">{{currentIndex + 1}} / {{filtered.length}}</view>
  </view>

  <!-- 题目卡片 -->
  <scroll-view scroll-y class="question-scroll" wx:if="{{currentQuestion && !loading && !loadError}}">
    <view class="card question-card">
      <view class="question-head">
        <text class="tag {{typeTagClass}}">{{typeLabel}}</text>
        <text class="question-level">{{currentQuestion.level}}</text>
        <view class="question-actions">
          <!-- 错题本 bookmark：仅判题结果态显示 -->
          <view wx:if="{{submitted}}" class="head-icon {{isWrongBook ? 'icon-bookmark-active' : 'icon-bookmark'}}" data-action="wrongbook" bindtap="onHeadAction"></view>
          <!-- 笔记 note：仅判题结果态显示 -->
          <view wx:if="{{submitted}}" class="head-icon {{hasNote ? 'icon-note-active' : 'icon-note'}}" data-action="note" bindtap="onHeadAction"></view>
          <!-- 收藏 star：全程可用 -->
          <view class="head-icon {{isFavorited ? 'icon-star-active' : 'icon-star'}}" data-action="favorite" bindtap="onHeadAction"></view>
        </view>
      </view>

      <text class="question-text">{{currentQuestion.question}}</text>

      <view class="options" wx:if="{{renderOptions.length}}">
        <view
          wx:for="{{renderOptions}}"
          wx:key="key"
          class="option {{item.cls}}"
          bindtap="onSelectOption"
          data-key="{{item.key}}"
          data-type="{{currentQuestion.type}}"
        >
          <radio wx:if="{{currentQuestion.type === 'single' || currentQuestion.type === 'judge'}}"
            checked="{{item.checked}}" color="#007aff" />
          <checkbox wx:elif="{{currentQuestion.type === 'multiple'}}"
            checked="{{item.checked}}" color="#007aff" />
          <text class="option-label">{{item.key}}. {{item.value}}</text>
        </view>
      </view>

      <!-- 提交按钮 -->
      <button wx:if="{{selectedKeys.length > 0 && !submitted}}" class="btn btn-primary btn-block submit-btn" bindtap="submitAnswer">
        提交答案
      </button>

      <!-- 反馈 -->
      <view wx:if="{{feedback}}" class="feedback {{feedback.class}}">
        <text class="feedback-title">{{feedback.title}}</text>
        <text class="feedback-body">{{feedback.body}}</text>
      </view>
    </view>

    <!-- 导航 -->
    <view class="nav-bar">
      <button class="btn btn-ghost" bindtap="prevQuestion" disabled="{{currentIndex <= 0}}">← 上一题</button>
      <button class="btn btn-ghost" bindtap="nextQuestion" disabled="{{currentIndex >= filtered.length - 1}}">下一题 →</button>
    </view>
  </scroll-view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && !loadError && !currentQuestion}}">
    <text>📚</text>
    <text>当前筛选没有题目</text>
    <text class="placeholder" wx:if="{{filterAnswerIndex === 0}}">当前筛选为"有答案的题"，试试切换到"全部理论题"</text>
  </view>

  <!-- 笔记弹窗 -->
  <view class="overlay {{noteModalVisible ? '' : 'hidden'}}" catchtap="closeNoteModal">
    <view class="note-modal" catchtap="noop">
      <text class="note-modal-title">📝 笔记</text>
      <textarea class="note-textarea" value="{{noteText}}" bindinput="onNoteInput" placeholder="记下你的思路、疑问或记忆要点…" maxlength="-1" auto-height></textarea>
      <view class="note-modal-actions">
        <button class="btn btn-ghost" catchtap="closeNoteModal">取消</button>
        <button class="btn btn-primary" catchtap="saveNote">保存</button>
      </view>
    </view>
  </view>
</view>