.page { min-height: 100vh; }

/* 介绍页 */
.intro { padding: 24px 16px; }
.intro-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 24px;
  box-shadow: var(--shadow);
  text-align: center;
}
.intro-icon { font-size: 48px; display: block; margin-bottom: 8px; }
.intro-title { font-size: 18px; font-weight: 600; display: block; margin-bottom: 16px; }
.intro-detail { margin-bottom: 20px; }
.intro-row {
  display: flex;
  justify-content: space-between;
  padding: 6px 0;
  font-size: 13px;
  color: var(--text-2);
  border-bottom: 1px solid var(--border);
}
.intro-row.total {
  font-weight: 600;
  color: var(--text-1);
  border-bottom: none;
}

/* 考试记录 */
.history-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 16px;
  margin-top: 16px;
  box-shadow: var(--shadow);
}
.history-title {
  font-size: 14px;
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
}
.history-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  padding: 8px 0;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
}
.history-row:last-child { border-bottom: none; }
.history-date {
  color: var(--text-3);
  white-space: nowrap;
  flex-shrink: 1;
}
.history-score {
  color: var(--text-1);
  font-weight: 600;
  white-space: nowrap;
  text-align: right;
  flex-shrink: 0;
}
.history-acc {
  color: var(--primary);
  font-weight: 600;
  white-space: nowrap;
  text-align: right;
  flex-shrink: 0;
  min-width: 48px;
}

/* 进行中 */
.exam-page { height: 100vh; display: flex; flex-direction: column; }
.exam-topbar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 16px;
  background: var(--card-bg);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}
.exam-progress { font-size: 13px; color: var(--text-2); }
.exam-timer {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}
.exam-timer.urgent { color: var(--danger); }
/* 收藏按钮靠右。
   原生 button 自带 margin-left/right: auto，按 Flexbox 规范 auto margin
   会先于对齐规则吃掉全部剩余空间，于是左右各分一半，图标浮在中间
   （既不靠左也不靠右）。清零后改用左 auto margin 推到最右，
   与理论学习页 .question-actions 的收藏图标位置保持一致。 */
.exam-topbar .btn-ghost { margin: 0 0 0 auto; }
.exam-scroll { flex: 1; padding-bottom: 16px; }

.exam-nav {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  padding: 0 16px;
  margin-top: 12px;
}
.exam-nav .btn { flex: 1; }

/* 悬浮导航按钮 */
.exam-nav-btn {
  position: fixed;
  right: 16px;
  bottom: 24px;
  width: 44px;
  height: 44px;
  border-radius: 22px;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  box-shadow: var(--shadow-md);
  z-index: 20;
}

/* 题号遮罩 + 面板 */
.exam-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 30;
  display: flex;
  align-items: flex-end;
}
.exam-overlay.hidden { display: none; }
.exam-navigator {
  background: var(--card-bg);
  border-radius: var(--radius) var(--radius) 0 0;
  padding: 16px;
  width: 100%;
  max-height: 70vh;
}
.navigator-scroll { max-height: 55vh; }
.nav-group { margin-bottom: 12px; }
.nav-group-title {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-3);
  display: block;
  margin-bottom: 6px;
}
.nav-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 4px;
}
.nav-num {
  position: relative;
  overflow: hidden;
  text-align: center;
  padding: 6px 0;
  border-radius: 4px;
  font-size: 13px;
  background: var(--bg);
  color: var(--text-2);
}
/* 已作答：实心填充。
   原来只把底色换成浅蓝(--primary-light)，与未作答的浅灰底
   实测 ΔE 仅 7.0（<10 需凑近分辨），扫一眼分不出来。
   改为实心蓝 + 白字后差异一目了然，白字对比度 5.77:1。 */
.nav-num.answered {
  background: #0b63c9;
  color: #ffffff;
  font-weight: 600;
}
/* 当前题：用外环表示，不用填充。
   这样「位置」和「是否作答」是两个独立通道，可以叠加。
   环色用深色 #1d1d1f 一种即可：外环画在格子外框之外，落在
   白色面板上，与面板对比 15.9:1，无论格子自身是灰底还是
   蓝底都清晰。
   注意不要用白环——面板背景就是白色，白环在白底上等于没画，
   实测「当前题+已作答」与「普通已作答」的差异为 0。 */
.nav-num.current { box-shadow: 0 0 0 2px #1d1d1f; }
/* 标记：右上角三角。
   原来是在数字后追加一个 8px 的 ★(#f5c518)，在浅灰底上对比度
   仅 1.50:1、在浅蓝底上 1.42:1（图形元素需 ≥3:1），等于没画。
   改为角标后，三角下垫一层白色三角做分离边：因为单一颜色不可能
   同时在浅灰底(需亮度≤0.27)和实心蓝底(需亮度≥0.49)上达到 3:1，
   加白边后只需在浅灰和白色上都达标，实测 3.29:1 / 3.58:1。 */
.nav-num.marked::before {
  content: '';
  position: absolute;
  top: 0; right: 0;
  border-top: 11px solid #ffffff;
  border-left: 11px solid transparent;
}
.nav-num.marked::after {
  content: '';
  position: absolute;
  top: 0; right: 0;
  border-top: 8px solid #e8590c;
  border-left: 8px solid transparent;
}

/* ── 图例：四个状态的含义 ── */
.nav-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding-bottom: 10px;
  margin-bottom: 12px;
  border-bottom: 1px solid var(--border);
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  color: var(--text-3);
}
.legend-box {
  position: relative;
  overflow: hidden;
  width: 14px;
  height: 14px;
  border-radius: 3px;
  background: var(--bg);
}
.legend-box.done { background: #0b63c9; }
.legend-box.cur { box-shadow: 0 0 0 2px #1d1d1f; }
.legend-box.mark::after {
  content: '';
  position: absolute;
  top: 0; right: 0;
  border-top: 9px solid #e8590c;
  border-left: 9px solid transparent;
}

/* 结果页 */
.result-page { padding: 24px 16px; }