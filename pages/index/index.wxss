.page { padding: 0 16px 32px; }

.hero {
  text-align: center;
  padding: 32px 0 24px;
}
.hero-title {
  font-size: 22px;
  font-weight: 600;
  color: var(--text-1);
  display: block;
}
.hero-sub {
  font-size: 13px;
  color: var(--text-3);
  margin-top: 6px;
  display: block;
}

.notice-card {
  background: #fff8e6;
  border: 1px solid #ffe7a3;
  border-radius: var(--radius);
  padding: 12px 16px;
  margin-bottom: 16px;
}
.notice-title {
  font-size: 13px;
  font-weight: 600;
  color: #b86200;
  display: block;
  margin-bottom: 4px;
}
.notice-body {
  font-size: 12px;
  color: #8b5e00;
  line-height: 1.6;
}

.stats-bar {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: var(--shadow);
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 24px;
  font-weight: 700;
  color: var(--primary);
  display: block;
}
.stat-denom {
  font-size: 14px;
  font-weight: 400;
  color: var(--text-3);
}
.stat-label {
  font-size: 11px;
  color: var(--text-3);
  margin-top: 2px;
  display: block;
}
.stat-divider {
  width: 1px;
  height: 32px;
  background: var(--border);
}

.entry-grid {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}
.entry-card {
  flex: 1;
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 20px 16px;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
}
.entry-card-hover { opacity: 0.85; }
.entry-num {
  font-size: 11px;
  color: var(--primary);
  font-weight: 500;
}
.entry-title {
  font-size: 16px;
  font-weight: 600;
  margin: 6px 0 4px;
  color: var(--text-1);
}
.entry-desc {
  font-size: 12px;
  color: var(--text-3);
  line-height: 1.5;
}

.exam-entry {
  display: flex;
  flex-direction: column;
  position: relative;
  background: linear-gradient(135deg, #e8f0fe, #f5f5ff);
  border-radius: var(--radius);
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: var(--shadow);
}
.exam-entry-label {
  font-size: 16px;
  font-weight: 600;
  color: var(--primary);
}
.exam-entry-desc {
  font-size: 12px;
  color: var(--text-3);
  margin-top: 4px;
}
.exam-entry-arrow {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24px;
  color: var(--text-4);
}

.footer-links {
  display: flex;
  gap: 12px;
}
.footer-link {
  flex: 1;
  text-align: center;
  padding: 12px;
  background: var(--card-bg);
  border-radius: var(--radius-sm);
  font-size: 13px;
  color: var(--text-2);
  box-shadow: var(--shadow);
}