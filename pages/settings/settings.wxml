<view class="page">
  <!-- AI 配置 -->
  <view class="section">
    <text class="section-title">智能评测配置</text>
    <text class="section-desc">自行提供 API Key，数据仅保存在本机。支持任何 OpenAI 兼容接口。</text>

    <view class="field">
      <text class="field-label">API 地址</text>
      <input class="field-input" value="{{baseUrl}}" bindinput="onBaseUrlInput" placeholder="https://api.deepseek.com/v1" />
    </view>

    <view class="field">
      <text class="field-label">API Key</text>
      <input class="field-input" value="{{apiKey}}" type="password" bindinput="onApiKeyInput" placeholder="sk-..." password="{{true}}" />
    </view>

    <view class="field">
      <text class="field-label">模型名称</text>
      <input class="field-input" value="{{model}}" bindinput="onModelInput" placeholder="deepseek-chat" />
    </view>

    <view class="settings-actions">
      <button class="btn btn-secondary" bindtap="testConnection">测试连接</button>
      <button class="btn btn-primary" bindtap="saveConfig">保存配置</button>
    </view>

    <text wx:if="{{testResult}}" class="test-result {{testResult.ok ? 'ok' : 'bad'}}">
      {{testResult.msg}}
    </text>
  </view>

  <!-- 反馈 -->
  <view class="section">
    <text class="section-title">📮 问题反馈</text>
    <text class="section-desc">发现题目有误、功能异常，或有什么建议？告诉我们，我们会尽快处理。</text>
    <button class="btn btn-secondary btn-block" bindtap="openFeedbackModal" style="margin-top:12px">
      提交反馈
    </button>
  </view>

  <!-- 关于 -->
  <view class="section about-section">
    <text class="about-title">AI Trainer 备考练习</text>
    <text class="about-version">v1.0.0</text>
    <button class="btn btn-ghost btn-sm github-btn" bindtap="copyGithubLink">
      ⭐ GitHub 上关注本项目
    </button>
  </view>

  <!-- 反馈弹窗 -->
  <view class="overlay {{feedbackModalVisible ? '' : 'hidden'}}" catchtap="closeFeedbackModal">
    <view class="feedback-modal" catchtap="noop">
      <text class="feedback-modal-title">📮 问题反馈</text>
      <textarea
        class="feedback-textarea"
        value="{{feedbackText}}"
        bindinput="onFeedbackTextInput"
        placeholder="描述你遇到的问题：哪道题答案有误、哪个功能不正常、或者你的建议…"
        maxlength="500"
        show-confirm-bar="{{false}}"
      ></textarea>
      <text class="feedback-count">{{feedbackText.length}} / 500</text>
      <view class="feedback-page" wx:if="{{feedbackPage}}">
        <text>📄 当前页面：{{feedbackPage}}</text>
      </view>
      <view class="feedback-actions">
        <button class="btn btn-ghost" bindtap="closeFeedbackModal">取消</button>
        <button class="btn btn-primary" bindtap="submitFeedback">提交反馈</button>
      </view>
    </view>
  </view>
</view>