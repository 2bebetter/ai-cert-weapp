.page { padding: 0 16px 32px; }

.section {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 16px;
  margin-top: 16px;
  box-shadow: var(--shadow);
}
.section-title {
  font-size: 15px;
  font-weight: 600;
  display: block;
  margin-bottom: 4px;
}
.section-desc {
  font-size: 12px;
  color: var(--text-3);
  display: block;
  margin-bottom: 14px;
  line-height: 1.5;
}

.field {
  margin-bottom: 12px;
}
.field-label {
  font-size: 12px;
  color: var(--text-2);
  display: block;
  margin-bottom: 4px;
}
.field-input {
  width: 100%;
  min-height: 44px;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 14px;
  background: var(--bg);
  box-sizing: border-box;
  line-height: 1.4;
}

.settings-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}
.settings-actions .btn { flex: 1; }

.test-result {
  display: block;
  margin-top: 8px;
  padding: 8px 12px;
  border-radius: 6px;
  font-size: 12px;
}
.test-result.ok { background: var(--success-bg); color: var(--success-text); }
.test-result.bad { background: var(--danger-bg); color: var(--danger-text); }

.about-section { text-align: center; }
.github-btn { margin-top: 12px; }
.about-title {
  font-size: 16px;
  font-weight: 600;
  display: block;
}
.about-version {
  font-size: 12px;
  color: var(--text-4);
  display: block;
  margin: 4px 0 8px;
}
.about-desc {
  font-size: 12px;
  color: var(--text-3);
  display: block;
  line-height: 1.6;
}

/* 反馈弹窗 */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--overlay);
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
}
.overlay {
  opacity: 1;
  visibility: visible;
  transition: opacity var(--dur) var(--ease), visibility var(--dur) var(--ease);
}
.overlay.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.feedback-modal {
  transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
}
.overlay.hidden .feedback-modal {
  opacity: 0;
  transform: translateY(14px) scale(0.98);
}
.feedback-modal {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 20px;
  width: 85%;
  max-width: 380px;
}
.feedback-modal-title {
  font-size: 16px;
  font-weight: 600;
  display: block;
  margin-bottom: 12px;
}
.feedback-textarea {
  width: 100%;
  min-height: 120px;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 14px;
  line-height: 1.6;
  box-sizing: border-box;
}
.feedback-count {
  display: block;
  text-align: right;
  font-size: 12px;
  color: var(--text-4);
  margin-top: 4px;
}
.feedback-page {
  font-size: 12px;
  color: var(--text-3);
  margin-top: 4px;
}
.feedback-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 12px;
}