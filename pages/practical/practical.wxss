.page { height: 100vh; display: flex; flex-direction: column; }

.filter-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: var(--card-bg);
  border-bottom: 1px solid var(--border);
}
.filter-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 12px;
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 12px;
  color: var(--text-2);
}
.filter-btn .arrow { font-size: 8px; color: var(--text-4); }
.filter-info {
  margin-left: auto;
  font-size: 12px;
  color: var(--text-3);
}

.progress-mini {
  display: flex;
  gap: 16px;
  padding: 12px 16px;
  background: var(--card-bg);
  margin: 8px 16px;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.progress-item {
  flex: 1;
  text-align: center;
  font-size: 11px;
  color: var(--text-3);
}
.progress-item .num {
  font-size: 18px;
  font-weight: 600;
  color: var(--primary);
  display: block;
  margin-bottom: 2px;
}

.task-scroll { flex: 1; padding: 0 0 16px; }

.task-card {
  background: var(--card-bg);
  margin: 6px 16px;
  padding: 14px 16px;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow);
}
.task-card-hover { opacity: 0.8; }
.task-title {
  font-size: 14px;
  font-weight: 500;
  display: block;
  margin-bottom: 8px;
}
.task-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
}
.task-versions { color: var(--text-3); }
.task-status {
  margin-left: auto;
  font-size: 11px;
}
.task-status.practiced { color: var(--success); }
.task-status.inProgress { color: var(--warning); }
.task-status.unattempted { color: var(--text-4); }