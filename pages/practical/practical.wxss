/* ══════════════════════════════════════════════════════════
   实操学习列表页
   顺序：页面标题 → 筛选 → 推荐练习 → 统计 → 按题型分组列表
   ══════════════════════════════════════════════════════════ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

.content {
  width: 94%;
  max-width: 760px;
  margin: 0 auto;
  padding: 16px 0 32px;
  box-sizing: border-box;
}

/* ── 页面标题 ── */
.page-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--text-1);
  line-height: 32px;
  margin-bottom: 14px;
}

/* ── 筛选栏 ── */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  border-radius: 18px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  font-size: 13px;
  color: var(--text-2);
  line-height: 18px;
}

.arrow {
  width: 6px;
  height: 6px;
  border-right: 1.5px solid var(--text-3);
  border-bottom: 1.5px solid var(--text-3);
  transform: rotate(45deg) translate(-1px, -1px);
}

.filter-info {
  margin-left: auto;
  font-size: 12px;
  color: var(--text-3);
}

/* ── 通用卡片 ── */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-sm);
  padding: 16px;
  margin: 0 0 20px;
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.card-title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 15px;
  font-weight: 700;
  color: var(--text-1);
  line-height: 22px;
  margin-bottom: 12px;
}

/* 图钉：纯 CSS 矢量图标 */

/* ══════════ 统计数据 ══════════ */
.stats-card {
  display: flex;
  align-items: center;
  padding: 16px 8px;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  min-width: 0;
}

.stat-num {
  font-size: 24px;
  font-weight: 700;
  line-height: 32px;
}

.stat-done { color: var(--success); }
.stat-doing { color: var(--warning); }
.stat-new { color: var(--primary); }

.stat-label {
  font-size: 12px;
  color: var(--text-3);
  line-height: 17px;
}

.stat-divider {
  width: 1px;
  height: 28px;
  background: var(--border);
  flex-shrink: 0;
}

/* ══════════ 分组 ══════════ */
.group {
  margin-bottom: 20px;
}

.group-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  background: var(--card-bg);
  box-shadow: var(--shadow);
  margin-bottom: 10px;
}

.group-head:active {
  opacity: 0.8;
}

.group-arrow {
  flex-shrink: 0;
  width: 7px;
  height: 7px;
  border-right: 1.8px solid var(--text-3);
  border-bottom: 1.8px solid var(--text-3);
  transform: rotate(-45deg);
}

.group-arrow.open {
  transform: rotate(45deg) translate(-2px, -2px);
}

.group-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-1);
  line-height: 22px;
  flex-shrink: 0;
}

.group-count {
  font-size: 12px;
  color: var(--text-3);
  line-height: 18px;
  margin-left: auto;
  flex-shrink: 0;
}

.group-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* ══════════ 题目卡片 ══════════ */
.task-card {
  padding: 14px;
  border-radius: var(--radius-sm);
  background: var(--card-bg);
  box-shadow: var(--shadow);
  box-sizing: border-box;
}

.task-card-hover {
  background: #fafbfd;
}

.task-head {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.task-title {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  font-weight: 600;
  color: var(--text-1);
  line-height: 22px;
  word-break: break-word;
}

/* 完整原题名称：小号灰色副标题 */
.task-sub {
  margin-top: 3px;
  font-size: 12px;
  color: var(--text-4);
  line-height: 17px;
  word-break: break-word;
}

/* ── 状态徽章 ── */
.task-badge {
  flex-shrink: 0;
  padding: 3px 9px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 600;
  line-height: 16px;
  white-space: nowrap;
}

.badge-new {
  background: #e8f0fe;
  color: #007aff;
}

.badge-doing {
  background: #fff4e0;
  color: #ff9500;
}

.badge-done {
  background: #e8f8ee;
  color: #34c759;
}

/* ── 标签行 ── */
.task-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 10px;
}

.task-variant {
  font-size: 11px;
  color: var(--text-3);
  line-height: 16px;
  padding: 2px 7px;
  border-radius: 9px;
  background: var(--bg);
}

.task-score {
  margin-left: auto;
  font-size: 12px;
  color: var(--text-3);
  line-height: 18px;
  flex-shrink: 0;
}

/* ── 进行中：进度 ── */
.task-progress {
  margin-top: 10px;
  padding: 7px 10px;
  border-radius: 6px;
  background: #fff8ec;
  color: #b86200;
  font-size: 12px;
  line-height: 18px;
  word-break: break-word;
}

/* ══════════ 空状态 / 加载 ══════════ */
.empty-state,
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 70px 20px;
  min-height: 50vh;
  box-sizing: border-box;
}

.empty-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-2);
}

.loading-text {
  font-size: 13px;
  color: var(--text-3);
}

.loading-spinner {
  width: 26px;
  height: 26px;
  border: 2px solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态图标：纯 CSS 矢量图形 */
.icon-empty {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-sm);
  border: 2px dashed var(--border);
  position: relative;
}

.icon-empty::after {
  content: '';
  position: absolute;
  left: 9px;
  top: 17px;
  width: 18px;
  height: 2px;
  background: var(--border);
  border-radius: 1px;
}
