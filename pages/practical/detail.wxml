<view class="page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中…</text>
  </view>

  <!-- 加载失败 -->
  <view class="empty-state" wx:elif="{{loadError}}">
    <text>😵</text>
    <text>题库加载失败</text>
    <text class="placeholder" wx:if="{{debugInfo}}">{{debugInfo}}</text>
    <text class="placeholder" wx:else>请确认 getQuestions 云函数已部署</text>
    <button class="btn btn-primary" bindtap="retry" style="margin-top:16px">重试</button>
  </view>

  <block wx:else>
    <!-- 任务标题与描述 -->
    <view class="task-header">
      <view class="task-tags">
        <text class="tag {{task.type === 'code' ? '' : 'tag-warning'}}">{{task.type === 'code' ? '代码填空' : '文档作答'}}</text>
        <text class="tag tag-success">{{task.maxScore}} 分</text>
      </view>
      <text class="task-title">{{task.title}}</text>
      <view class="task-question">
        <text>{{task.question}}</text>
      </view>
    </view>

    <!-- 评分标准（默认收起，可展开） -->
    <view class="criteria-section" wx:if="{{task.scoreItems.length}}">
      <view class="criteria-header" bindtap="toggleCriteria">
        <text class="criteria-title">📋 评分标准（{{task.maxScore}} 分）</text>
        <text class="criteria-arrow">{{criteriaOpen ? '▲' : '▼'}}</text>
      </view>
      <view class="criteria-body" wx:if="{{criteriaOpen}}">
        <view wx:for="{{task.scoreItems}}" wx:key="id" class="criteria-item">
          <text class="criteria-item-score">{{item.score}} 分</text>
          <text class="criteria-item-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 作答区 -->
    <view class="answer-section">
      <text class="section-title">作答区</text>

      <!-- 混合题：先代码，后文档 -->
      <block wx:if="{{task.type === 'mixed'}}">
        <text class="sub-section-title">📝 代码部分</text>
        <block wx:if="{{codeLines.length}}">
          <scroll-view class="code-scroll" scroll-y scroll-x enhanced show-scrollbar="{{true}}">
            <view class="code-editor">
              <view wx:for="{{codeLines}}" wx:for-item="line" wx:key="index" class="code-line">
                <text class="line-num">{{index + 1}}</text>
                <view class="line-content">
                  <block wx:for="{{line}}" wx:for-item="part" wx:key="index">
                    <input wx:if="{{part.kind === 'blank'}}"
                      class="code-blank"
                      value="{{blankValues[part.id] || ''}}"
                      data-blank-id="{{part.id}}"
                      bindinput="onBlankInput"
                      placeholder=""
                      adjust-position="{{false}}"
                    />
                    <text wx:else class="code-text">{{part.value}}</text>
                  </block>
                </view>
              </view>
            </view>
          </scroll-view>
        </block>
        <block wx:else>
          <view class="no-template-tip">代码模板加载中，请先填写下方文档部分</view>
        </block>

        <text class="sub-section-title" style="margin-top:16px">📄 文档作答部分</text>
        <textarea
          class="doc-area"
          value="{{docAnswer}}"
          bindinput="onAnswerInput"
          placeholder="在此填写文档/分析内容…"
          maxlength="-1"
          auto-height
        ></textarea>
      </block>

      <!-- 纯代码题 -->
      <block wx:elif="{{task.type === 'code'}}">
        <block wx:if="{{codeLines.length}}">
          <scroll-view class="code-scroll" scroll-y scroll-x enhanced show-scrollbar="{{true}}">
            <view class="code-editor">
              <view wx:for="{{codeLines}}" wx:for-item="line" wx:key="index" class="code-line">
                <text class="line-num">{{index + 1}}</text>
                <view class="line-content">
                  <block wx:for="{{line}}" wx:for-item="part" wx:key="index">
                    <input wx:if="{{part.kind === 'blank'}}"
                      class="code-blank"
                      value="{{blankValues[part.id] || ''}}"
                      data-blank-id="{{part.id}}"
                      bindinput="onBlankInput"
                      placeholder=""
                      adjust-position="{{false}}"
                    />
                    <text wx:else class="code-text">{{part.value}}</text>
                  </block>
                </view>
              </view>
            </view>
          </scroll-view>
        </block>
        <block wx:else>
          <view class="no-template-tip">等待代码模板加载，你可以先在这里写代码</view>
          <textarea
            class="code-area"
            value="{{answer}}"
            bindinput="onAnswerInput"
            placeholder="在此写代码…import pandas as pd"
            maxlength="-1"
            auto-height
          ></textarea>
        </block>
      </block>

      <!-- 纯文档题 -->
      <block wx:else>
        <textarea
          class="doc-area"
          value="{{answer}}"
          bindinput="onAnswerInput"
          placeholder="在此填写作答内容…"
          maxlength="-1"
          auto-height
        ></textarea>
      </block>

      <!-- 操作按钮 -->
      <view class="actions">
        <button class="btn btn-secondary" bindtap="saveDraft">保存草稿</button>
        <button class="btn btn-primary" bindtap="submitGrade" disabled="{{!hasContent}}">
          ✅ 智能评测
        </button>
      </view>

      <!-- 评分结果 -->
      <view wx:if="{{gradeResult}}" class="grade-result {{gradeResult.error ? 'bad' : 'ok'}}">
        <block wx:if="{{gradeResult.error}}">
          <text class="grade-title">判分失败：{{gradeResult.error}}</text>
        </block>
        <block wx:else>
          <text class="grade-title">智能评测：{{gradeResult.total_score}} / {{gradeResult.maxScore}} 分</text>
          <view wx:for="{{gradeResult.items}}" wx:key="id" class="grade-item">
            <text>{{item.id}}：{{item.score}} / {{item.max_score}} · {{item.reason}}</text>
          </view>
        </block>
      </view>
    </view>
  </block>
</view>