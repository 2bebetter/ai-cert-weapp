.page { min-height: 100vh; display: flex; flex-direction: column; }

/* 加载 */
.loading-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }

/* 任务区 */
.task-scroll { flex: 1; padding: 0 0 24px; }

.task-card { margin: 12px 16px; }
.task-title {
  font-size: 16px;
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
  line-height: 1.5;
}
.task-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}
.task-info { font-size: 12px; color: var(--text-3); }

.task-question {
  margin-top: 12px;
  padding: 12px;
  background: var(--bg);
  border-radius: var(--radius-sm);
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-2);
}

/* 评分标准 */
.criteria-section { margin-top: 12px; }
.criteria-header {
  display: flex;
  align-items: center;
  padding: 8px 0;
  font-size: 13px;
}
.criteria-title { flex: 1; }
.criteria-arrow { font-size: 10px; color: var(--text-4); }
.criteria-body {
  padding: 8px 12px;
  background: var(--bg);
  border-radius: var(--radius-sm);
}
.criteria-item {
  display: flex;
  gap: 8px;
  padding: 6px 0;
  font-size: 12px;
  border-bottom: 1px solid var(--border);
}
.criteria-item:last-child { border-bottom: none; }
.criteria-item-score {
  flex-shrink: 0;
  color: var(--primary);
  font-weight: 500;
  min-width: 30px;
}
.criteria-item-desc { color: var(--text-3); line-height: 1.5; }

/* 作答区 */
.answer-section { margin-top: 16px; }
.section-title {
  font-size: 14px;
  font-weight: 600;
  display: block;
  margin-bottom: 10px;
}
.sub-section-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-2);
  display: block;
  margin-bottom: 10px;
}

/* 代码编辑器 */
.code-scroll {
  background: #1e1e2e;
  border-radius: var(--radius-sm);
  max-height: 60vh;
  padding: 4px 0;
}
.code-editor { font-family: 'Menlo', 'Consolas', monospace; font-size: 12px; line-height: 1.6; }
.code-line { display: flex; min-height: 22px; }
.line-num {
  width: 32px;
  text-align: right;
  padding-right: 10px;
  color: #6c6c8a;
  flex-shrink: 0;
  user-select: none;
  font-size: 11px;
  line-height: 22px;
}
.line-content {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  white-space: pre;
}
.code-text {
  color: #cdd6f4;
  white-space: pre;
  line-height: 22px;
}
.code-blank {
  background: #313244;
  border: 1px solid #45475a;
  border-radius: 3px;
  color: #f5e0dc;
  padding: 1px 6px;
  min-width: 80px;
  font-size: 12px;
  height: 22px;
  line-height: 20px;
  box-sizing: border-box;
}
.code-blank-ref {
  color: #a6e3a1;
  background: #313244;
  border: 1px dashed #585b70;
  border-radius: 3px;
  padding: 1px 6px;
  font-size: 12px;
  line-height: 22px;
  margin: 0 2px;
}

.no-template-tip {
  padding: 12px;
  background: var(--bg);
  border-radius: var(--radius-sm);
  font-size: 13px;
  color: var(--text-3);
  text-align: center;
  margin-bottom: 12px;
}

/* 文档作答区 */
.doc-section {
  margin-bottom: 16px;
}
.doc-section .sub-section-title {
  margin-bottom: 8px;
}
.doc-area {
  width: 100%;
  min-height: 160px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px;
  font-size: 14px;
  line-height: 1.7;
  box-sizing: border-box;
}

.actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}
.actions .btn { flex: 1; }

.grade-result {
  margin-top: 12px;
  padding: 12px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  line-height: 1.6;
}
.grade-result.ok { background: #e8f8ee; }
.grade-result.bad { background: #ffe8e6; }
.grade-title {
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
}
.grade-mode { font-weight: 400; font-size: 11px; color: var(--text-3); }
.grade-item {
  padding: 4px 0;
  border-top: 1px solid rgba(0,0,0,0.08);
}

/* 参考答案 */
.reference-section {
  margin-top: 12px;
  border-top: 1px solid var(--border);
  padding-top: 12px;
}
.reference-header {
  display: flex;
  align-items: center;
  font-size: 13px;
}
.reference-title { flex: 1; color: var(--primary); }
.reference-arrow { font-size: 10px; color: var(--text-4); }
.mistakes {
  margin-top: 12px;
  padding: 10px 12px;
  background: #fff8e1;
  border-radius: var(--radius-sm);
}
.mistakes-title {
  font-size: 12px;
  font-weight: 600;
  display: block;
  color: #b86200;
  margin-bottom: 6px;
}
.mistake-item {
  display: block;
  font-size: 12px;
  color: #8b5e00;
  line-height: 1.6;
}