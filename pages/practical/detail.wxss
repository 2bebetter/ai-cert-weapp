/* ══════════════════════════════════════════════════════════
   实操题详情页
   布局约束：内容宽 760px 居中，窄屏占 94%；模块间距 20px
   ══════════════════════════════════════════════════════════ */

page {
  background: var(--bg-soft);
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 内容容器：最大 760px，页面居中 ── */
/* 内容容器：三张卡片共用这一条宽度 */
.content {
  width: 98%;
  max-width: 1400px;   /* 基本不设限，窄屏吃满、宽屏也铺开 */
  margin: 0 auto;
  padding: 20px 0 40px;
  box-sizing: border-box;
}

/* ── 通用卡片：圆角 8px，模块之间 20px ── */
.card {
  background: var(--card-bg);
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 20px;
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: 0 1px 3px var(--shadow-sm);
}

.card:last-child {
  margin-bottom: 0;
}

/* ══════════ 卡片头 ══════════ */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 44px;
}

.card-head.static {
  margin-bottom: 12px;
}

.card-head-left {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  flex: 1;
}

.card-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-1);
  line-height: 24px;
}

.head-hint {
  font-size: 12px;
  color: var(--text-3);
  flex-shrink: 0;
}

/* 矢量图标（纯 CSS，无 emoji） */
.icon-book,
.icon-score,
.icon-code {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  border-radius: 3px;
  position: relative;
}

.icon-book {
  background: var(--primary-dark);
}

.icon-book::after {
  content: '';
  position: absolute;
  left: 3px;
  top: 3px;
  width: 2px;
  height: 10px;
  background: var(--card-bg);
  border-radius: 1px;
}

.icon-score {
  background: var(--warning);
  border-radius: 50%;
}

.icon-score::after {
  content: '';
  position: absolute;
  left: 4px;
  top: 6px;
  width: 8px;
  height: 2px;
  background: var(--card-bg);
  border-radius: 1px;
}

.icon-code {
  background: var(--success);
}

/* 展开 / 收起按钮 */
.toggle-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  padding: 4px 10px;
  border-radius: 14px;
  background: var(--primary-soft);
  font-size: 12px;
  color: var(--primary-dark);
  line-height: 18px;
}

.chev {
  width: 6px;
  height: 6px;
  border-right: 1.5px solid var(--primary-dark);
  border-bottom: 1.5px solid var(--primary-dark);
  transform: rotate(45deg) translate(-1px, -1px);
}

.chev-up {
  transform: rotate(-135deg) translate(-2px, -2px);
}

/* ══════════ 1. 题干卡片 ══════════ */
.question-card {
  background: var(--bg-soft);
  border: 1px solid var(--border);
}

.q-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-1);
  line-height: 22px;
  margin: 12px 0 4px;
}

.qsec {
  margin-top: 14px;
}

.qsec-label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-3);
  line-height: 18px;
  margin-bottom: 6px;
  letter-spacing: 0.4px;
}

.qsec-text {
  font-size: 13px;
  color: var(--text-2);
  line-height: 1.6;
  word-break: break-word;
}

/* 任务要求：有序列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.task-item {
  display: flex;
  gap: 8px;
  align-items: flex-start;
}

.task-num {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  margin-top: 2px;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 12px;
  font-weight: 600;
  text-align: center;
  line-height: 18px;
}

.task-text {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: var(--text-2);
  line-height: 1.6;
  word-break: break-word;
}

/* 收起时的截断：必须让「收起」明显变短，否则用户会以为没反应 */
.clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.clamp-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* 折叠提示：纯文字，不是按钮（正式开关只有右上角那一个） */
.collapse-hint {
  min-height: 44px;
  box-sizing: border-box;
  padding: 13px 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10px;
  font-size: 12px;
  color: var(--text-5);
  line-height: 18px;
  text-align: center;
}

/* 等宽高亮（字段名 / 文件名 / 文件夹名） */
.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  background: var(--border-soft);
  color: var(--primary-deep);
  border-radius: 3px;
  padding: 0 4px;
  font-size: 12px;
}

.mono-hl {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  background: var(--primary-deep-soft);
  color: var(--primary-deep);
  border-radius: 3px;
  padding: 0 4px;
  font-size: 12px;
}

/* 字段说明块 */
.mono-box {
  background: var(--bg-soft);
  border-radius: 6px;
  padding: 10px 12px;
  line-height: 1.8;
  word-break: break-word;
}

/* 输出规则：浅黄提示底（高频丢分信息） */
.warn-box {
  background: var(--warning-bg);
  border-left: 3px solid var(--warning);
  border-radius: 6px;
  padding: 10px 12px;
  font-size: 13px;
  color: var(--warning-text);
  line-height: 1.7;
  word-break: break-word;
  white-space: pre-wrap;
}

/* ══════════ 2. 评分标准 ══════════ */
.criteria-body {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.criteria-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 8px 10px;
  border-radius: 6px;
  background: var(--bg-soft);
}

.criteria-item-mark {
  flex-shrink: 0;
  font-size: 13px;
  color: var(--primary-dark);
  line-height: 20px;
}

.criteria-item-desc {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: var(--text-2);
  line-height: 20px;
  word-break: break-word;
}

.criteria-item-score {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 600;
  color: var(--warning);
  line-height: 20px;
}

/* ══════════ 3. 代码作答区 ══════════ */
/* 作答区：与其它卡片同宽同内边距（原来是左16/右0 + margin-right 的补丁） */
.answer-section {
  padding: 12px;
}

.answer-section .card-head {
  padding-right: 0;
}

/* 代码容器：max-height 420px，内部纵向滚动 */
.code-scroll {
  max-height: 560px;   /* 代码区高度：560px ≈ 19 行；想再高改这一行 */
  background: var(--code-bg);
  border-radius: 8px;
  box-sizing: border-box;
  /* 横向滚动：内容不换行，由 scroll-view 承载横向溢出 */
  white-space: nowrap;
}

.code-editor {
  padding: 10px 0;
  display: inline-block;
  min-width: 100%;
  box-sizing: border-box;
  vertical-align: top;
}

/* 代码行：行高固定 28px */
.code-line {
  display: flex;
  align-items: flex-start;
  min-height: 28px;
  line-height: 28px;
}

.line-num {
  flex-shrink: 0;
  width: 30px;
  padding-right: 6px;
  text-align: right;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 28px;
  color: var(--code-line);
}

.line-content {
  /* 不收缩：让长行撑开容器，交由 scroll-view 横向滚动，避免文字被裁掉 */
  flex: 0 0 auto;
  padding-right: 14px;
  line-height: 28px;
  white-space: pre;
}

.code-text {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 28px;
  color: var(--code-text);
}

/* 填空输入框：行内组件，不改变 28px 行高 */
.code-blank {
  display: inline-block;
  width: 108px;
  height: 22px;
  min-height: 22px;
  line-height: 22px;
  padding: 0 6px;
  margin: 0 2px;
  vertical-align: middle;
  box-sizing: border-box;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 12px;
  color: var(--code-key);
  background: var(--code-key-soft);
  border: none;
  border-bottom: 1px dashed var(--text-4);
  border-radius: 3px;
}

/* 验证后的填空结果：仍是行内组件 */
.blank-result {
  display: inline-block;
  vertical-align: middle;
  max-width: 100%;
  padding: 1px 6px;
  margin: 0 2px;
  border-radius: 4px;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 20px;
  white-space: normal;
  word-break: break-all;
}

.blank-user-value {
  font-size: 12px;
  line-height: 20px;
}

.blank-ref-line {
  display: block;
  font-size: 12px;
  line-height: 16px;
  color: var(--text-5);
}

.blank-ref-tag {
  font-size: 12px;
  color: var(--text-4);
}

.blank-ref-ok {
  display: flex;
  align-items: center;
  gap: 3px;
  color: var(--code-ok);
}

/* 对勾：纯 CSS 矢量图标 */
.icon-check {
  flex-shrink: 0;
  width: 8px;
  height: 4px;
  border-left: 1.5px solid var(--code-ok);
  border-bottom: 1.5px solid var(--code-ok);
  transform: rotate(-45deg) translateY(-1px);
}

/* 答对：绿 */
.blank-correct {
  background: var(--code-ok-soft);
  color: var(--code-ok);
  border: 1px solid var(--code-ok-line);
}

/* 答错：红 + 删除线 + 下方给参考答案 */
.blank-wrong {
  background: var(--code-err-soft);
  color: var(--code-err);
  border: 1px solid var(--code-err-line);
}

.blank-wrong .blank-user-value {
  text-decoration: line-through;
}

/* 未填：红 */
.blank-empty {
  background: var(--code-err-soft);
  color: var(--code-err);
  border: 1px solid var(--code-err-line);
}

.no-template-tip {
  font-size: 13px;
  color: var(--text-3);
  line-height: 20px;
  padding: 16px 16px 16px 0;
}

/* ── 验证结果总分 ── */
.verify-summary {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
  margin: 12px 16px 0 0;
  padding: 10px 12px;
  border-radius: 6px;
  font-size: 13px;
  line-height: 20px;
}

.summary-pass {
  background: var(--success-bg);
  color: var(--success-text);
}

.summary-fail {
  background: var(--warning-bg);
  color: var(--warning-text);
}

.summary-score {
  font-size: 15px;
  font-weight: 600;
}

.summary-count {
  font-size: 12px;
  color: var(--text-3);
}

/* ── 评分点明细 ── */
.point-list {
  margin: 10px 16px 0 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.point-row {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 7px 10px;
  border-radius: 6px;
  font-size: 13px;
  line-height: 19px;
}

.point-badge {
  flex-shrink: 0;
  font-size: 12px;
  font-weight: 600;
}

.point-desc {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.point-full {
  background: var(--success-bg);
  color: var(--success-text);
}

.point-part {
  background: var(--warning-bg);
  color: var(--warning-text);
}

.point-zero {
  background: var(--danger-bg);
  color: var(--danger-text);
}

.point-doc {
  background: var(--border-soft);
  color: var(--text-3);
}

/* ── 文档作答区 ── */
.sub-section-title {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-2);
  line-height: 20px;
  margin: 16px 0 8px;
}

.doc-section {
  margin-bottom: 4px;
}

.doc-area {
  width: 100%;
  min-height: 110px;
  box-sizing: border-box;
  padding: 10px 12px;
  /* width:100% 不能再加 margin-right，否则溢出卡片被裁掉 */
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-1);
}

/* ══════════ 4. 底部操作栏 ══════════ */
.action-bar {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
}

.action-bar .btn {
  flex: 1;
  min-height: 44px;
  line-height: 44px;
  border-radius: 8px;
  font-size: 15px;
  padding: 0 12px;
}

.btn-secondary {
  background: var(--card-bg);
  color: var(--text-2);
  border: 1px solid var(--border-strong);
}

.btn-primary {
  background: var(--primary-dark);
  color: var(--card-bg);
}

.btn-primary[disabled] {
  background: var(--border-strong);
  color: var(--bg-soft);
}

/* ── 评分结果（文档 / 混合题） ── */
.grade-result .grade-title {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-1);
  line-height: 22px;
  margin-bottom: 8px;
}

.grade-result.bad .grade-title {
  color: var(--danger-text);
}

.grade-mode {
  font-size: 12px;
  font-weight: 400;
  color: var(--text-3);
}

.grade-item {
  font-size: 13px;
  color: var(--text-2);
  line-height: 20px;
  padding: 4px 0;
  word-break: break-word;
}

/* ══════════ 5. 解析弹窗 ══════════ */
.analysis-overlay {
  animation: overlay-in var(--dur) var(--ease);
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: var(--overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  box-sizing: border-box;
}

.analysis-modal {
  animation: modal-in var(--dur) var(--ease);
  width: 92%;
  max-width: 860px;
  max-height: 70vh;
  background: var(--card-bg);
  border-radius: 8px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.analysis-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  border-bottom: 1px solid var(--border-soft);
}

.analysis-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-1);
  line-height: 22px;
}

.analysis-close::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44px;
  height: 44px;
  transform: translate(-50%, -50%);
}

.analysis-close {
  position: relative;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-soft);
}

.icon-close {
  width: 12px;
  height: 12px;
  position: relative;
}

.icon-close::before,
.icon-close::after {
  content: '';
  position: absolute;
  left: 0;
  top: 5px;
  width: 12px;
  height: 1.5px;
  background: var(--text-3);
  border-radius: 1px;
}

.icon-close::before {
  transform: rotate(45deg);
}

.icon-close::after {
  transform: rotate(-45deg);
}

/* 内容区：超高时弹窗内部滚动 */
.analysis-body {
  flex: 1;
  min-height: 0;
  max-height: calc(70vh - 57px);
  padding: 16px;
  box-sizing: border-box;
}

.analysis-block {
  margin-bottom: 16px;
}

.analysis-block:last-child {
  margin-bottom: 0;
}

.analysis-label {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: var(--text-1);
  line-height: 22px;
  margin-bottom: 6px;
}

.analysis-text {
  font-size: 13px;
  color: var(--text-2);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.analysis-none {
  color: var(--text-5);
}

/* 行内代码片段：灰底等宽 */
.inline-code {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 12px;
  background: var(--bg-soft);
  color: var(--danger-text);
  border-radius: 3px;
  padding: 1px 4px;
}

/* ══════════ 加载 / 空态 ══════════ */
.loading-wrap,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 80px 20px;
  min-height: 60vh;
  box-sizing: border-box;
}

.loading-spinner {
  width: 28px;
  height: 28px;
  border: 2px solid var(--border-strong);
  border-top-color: var(--primary-dark);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 13px;
  color: var(--text-3);
}

.empty-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-1);
}

.placeholder {
  font-size: 12px;
  color: var(--text-5);
  text-align: center;
  line-height: 1.6;
}

.empty-state .btn {
  min-height: 44px;
  line-height: 44px;
  border-radius: 8px;
  font-size: 15px;
  padding: 0 32px;
}
