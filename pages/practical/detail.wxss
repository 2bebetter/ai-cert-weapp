.page { padding: 0 16px 32px; }

.task-header {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 16px;
  margin-top: 12px;
  box-shadow: var(--shadow);
}
.task-tags { display: flex; gap: 6px; margin-bottom: 8px; }
.task-title {
  font-size: 16px;
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
}
.task-question {
  font-size: 13px;
  color: var(--text-2);
  line-height: 1.7;
  display: block;
}

.answer-section {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 16px;
  margin-top: 12px;
  box-shadow: var(--shadow);
}
.section-title {
  font-size: 14px;
  font-weight: 600;
  display: block;
  margin-bottom: 10px;
}

/* 代码编辑器 */
.code-scroll {
  max-height: 70vh;
  background: #1e1e1e;
  border-radius: var(--radius-sm);
  padding: 8px 0;
  margin-bottom: 16px;
}
.code-editor { font-family: 'Menlo', 'Courier New', monospace; font-size: 13px; line-height: 1.7; }
.code-line {
  display: flex;
  padding: 0 8px;
}
.code-line:hover { background: rgba(255,255,255,0.05); }
.line-num {
  width: 32px;
  text-align: right;
  padding-right: 12px;
  color: #858585;
  font-size: 12px;
  flex-shrink: 0;
  user-select: none;
}
.line-content { flex: 1; display: flex; flex-wrap: wrap; }
.code-text {
  color: #d4d4d4;
  white-space: pre;
  font-family: 'Menlo', 'Courier New', monospace;
  font-size: 13px;
  line-height: 1.7;
}
.code-blank {
  display: inline-block;
  min-width: 80px;
  max-width: 300px;
  background: #2d2d2d;
  color: #f5c518;
  border: none;
  border-bottom: 2px solid #f5c518;
  padding: 0 6px;
  font-family: 'Menlo', 'Courier New', monospace;
  font-size: 13px;
  line-height: 1.7;
  height: 24px;
  outline: none;
}
.code-blank:focus {
  background: #3a3a3a;
  border-bottom-color: #ff9800;
}
.code-blank::placeholder { color: #666; }

/* 文档作答区 */
.doc-area {
  width: 100%;
  min-height: 160px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px;
  font-size: 14px;
  line-height: 1.7;
  box-sizing: border-box;
  margin-bottom: 16px;
}

/* 自评评分点 */
.self-score { margin-bottom: 16px; }
.score-hint {
  font-size: 12px;
  color: var(--text-3);
  display: block;
  margin-bottom: 10px;
}
.score-item {
  display: flex;
  align-items: flex-start;
  padding: 8px 10px;
  margin: 4px 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 13px;
  line-height: 1.5;
}
.score-item:active { border-color: var(--primary); background: var(--primary-light); }
.score-item checkbox { margin-right: 8px; margin-top: 1px; flex-shrink: 0; }
.score-desc {
  flex: 1;
  color: var(--text-2);
  line-height: 1.5;
  margin-right: 8px;
}
.score-value {
  color: var(--primary);
  font-weight: 500;
  flex-shrink: 0;
  font-size: 12px;
}
.score-total {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 4px;
  padding: 8px 0;
  font-size: 13px;
  color: var(--text-2);
  border-top: 1px solid var(--border);
  margin-top: 8px;
}
.total-num { font-size: 16px; font-weight: 700; color: var(--primary); }

.actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}
.actions .btn { flex: 1; }

.grade-result {
  margin-top: 12px;
  padding: 12px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  line-height: 1.6;
}
.grade-result.ok { background: #e8f8ee; }
.grade-result.bad { background: #ffe8e6; }
.grade-title {
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
}
.grade-item {
  padding: 4px 0;
  border-top: 1px solid rgba(0,0,0,0.08);
}