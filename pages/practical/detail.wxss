.page { padding: 0 16px 32px; }

.task-header {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 16px;
  margin-top: 12px;
  box-shadow: var(--shadow);
}
.task-tags { display: flex; gap: 6px; margin-bottom: 8px; }
.task-title {
  font-size: 16px;
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
}
.task-question {
  font-size: 13px;
  color: var(--text-2);
  line-height: 1.7;
  display: block;
}

.answer-section {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 16px;
  margin-top: 12px;
  box-shadow: var(--shadow);
}
.section-title {
  font-size: 14px;
  font-weight: 600;
  display: block;
  margin-bottom: 10px;
}

/* 代码编辑器 */
.code-scroll {
  max-height: 70vh;
  background: #1e1e1e;
  border-radius: var(--radius-sm);
  padding: 8px 0;
  margin-bottom: 16px;
}
.code-editor { font-family: 'Menlo', 'Courier New', monospace; font-size: 13px; line-height: 1.7; }
.code-line {
  display: flex;
  padding: 0 8px;
}
.code-line:hover { background: rgba(255,255,255,0.05); }
.line-num {
  width: 32px;
  text-align: right;
  padding-right: 12px;
  color: #858585;
  font-size: 12px;
  flex-shrink: 0;
  user-select: none;
}
.line-content { flex: 1; display: flex; flex-wrap: wrap; }
.code-text {
  color: #d4d4d4;
  white-space: pre;
  font-family: 'Menlo', 'Courier New', monospace;
  font-size: 13px;
  line-height: 1.7;
}
.code-blank {
  display: inline-block;
  min-width: 80px;
  max-width: 300px;
  background: #2d2d2d;
  color: #f5c518;
  border: none;
  border-bottom: 2px solid #f5c518;
  padding: 0 6px;
  font-family: 'Menlo', 'Courier New', monospace;
  font-size: 13px;
  line-height: 1.7;
  height: 24px;
  outline: none;
}
.code-blank:focus {
  background: #3a3a3a;
  border-bottom-color: #ff9800;
}
.code-blank::placeholder { color: #666; }

/* 文档作答区 */
.doc-area {
  width: 100%;
  min-height: 160px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px;
  font-size: 14px;
  line-height: 1.7;
  box-sizing: border-box;
  margin-bottom: 16px;
}

/* 评分标准（可折叠） */
.criteria-section {
  background: var(--card-bg);
  border-radius: var(--radius);
  margin-top: 12px;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.criteria-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  font-size: 13px;
}
.criteria-header:active { background: var(--bg); }
.criteria-title { color: var(--text-2); font-weight: 500; }
.criteria-arrow { color: var(--text-4); font-size: 10px; }
.criteria-body {
  border-top: 1px solid var(--border);
  padding: 8px 16px 12px;
}
.criteria-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 5px 0;
  font-size: 12px;
  line-height: 1.5;
  border-bottom: 1px solid var(--border);
}
.criteria-item:last-child { border-bottom: none; }
.criteria-item-score {
  flex-shrink: 0;
  color: var(--primary);
  font-weight: 500;
  min-width: 30px;
}
.criteria-item-desc { color: var(--text-3); line-height: 1.5; }

.actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}
.actions .btn { flex: 1; }

.grade-result {
  margin-top: 12px;
  padding: 12px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  line-height: 1.6;
}
.grade-result.ok { background: #e8f8ee; }
.grade-result.bad { background: #ffe8e6; }
.grade-title {
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
}
.grade-item {
  padding: 4px 0;
  border-top: 1px solid rgba(0,0,0,0.08);
}