/* ══════════════════════════════════════════════════════════
   实操题详情页
   布局约束：内容宽 760px 居中，窄屏占 94%；模块间距 20px
   ══════════════════════════════════════════════════════════ */

page {
  background: #f4f6f9;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 内容容器：最大 760px，页面居中 ── */
.content {
  width: 94%;
  max-width: 760px;
  margin: 0 auto;
  padding: 20px 0 40px;
  box-sizing: border-box;
}

/* ── 通用卡片：圆角 8px，模块之间 20px ── */
.card {
  background: #ffffff;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 20px;
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(16, 24, 40, 0.06);
}

.card:last-child {
  margin-bottom: 0;
}

/* ══════════ 卡片头 ══════════ */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 28px;
}

.card-head.static {
  margin-bottom: 12px;
}

.card-head-left {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  flex: 1;
}

.card-title {
  font-size: 15px;
  font-weight: 600;
  color: #1f2937;
  line-height: 24px;
}

.head-hint {
  font-size: 12px;
  color: #6b7280;
  flex-shrink: 0;
}

/* 矢量图标（纯 CSS，无 emoji） */
.icon-book,
.icon-score,
.icon-code {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  border-radius: 3px;
  position: relative;
}

.icon-book {
  background: #2563eb;
}

.icon-book::after {
  content: '';
  position: absolute;
  left: 3px;
  top: 3px;
  width: 2px;
  height: 10px;
  background: #ffffff;
  border-radius: 1px;
}

.icon-score {
  background: #f59e0b;
  border-radius: 50%;
}

.icon-score::after {
  content: '';
  position: absolute;
  left: 4px;
  top: 6px;
  width: 8px;
  height: 2px;
  background: #ffffff;
  border-radius: 1px;
}

.icon-code {
  background: #10b981;
}

/* 展开 / 收起按钮 */
.toggle-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  padding: 4px 10px;
  border-radius: 14px;
  background: #eef2ff;
  font-size: 12px;
  color: #2563eb;
  line-height: 18px;
}

.chev {
  width: 6px;
  height: 6px;
  border-right: 1.5px solid #2563eb;
  border-bottom: 1.5px solid #2563eb;
  transform: rotate(45deg) translate(-1px, -1px);
}

.chev-up {
  transform: rotate(-135deg) translate(-2px, -2px);
}

/* ══════════ 1. 题干卡片 ══════════ */
.question-card {
  background: #fbfcfe;
  border: 1px solid #e6eaf2;
}

.q-title {
  font-size: 14px;
  font-weight: 600;
  color: #111827;
  line-height: 22px;
  margin: 12px 0 4px;
}

.qsec {
  margin-top: 14px;
}

.qsec-label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: #6b7280;
  line-height: 18px;
  margin-bottom: 6px;
  letter-spacing: 0.4px;
}

.qsec-text {
  font-size: 13px;
  color: #374151;
  line-height: 1.6;
  word-break: break-word;
}

/* 任务要求：有序列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.task-item {
  display: flex;
  gap: 8px;
  align-items: flex-start;
}

.task-num {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  margin-top: 2px;
  border-radius: 50%;
  background: #e0e7ff;
  color: #3730a3;
  font-size: 11px;
  font-weight: 600;
  text-align: center;
  line-height: 18px;
}

.task-text {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: #374151;
  line-height: 1.6;
  word-break: break-word;
}

/* 收起时的截断：必须让「收起」明显变短，否则用户会以为没反应 */
.clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.clamp-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* 展开 / 收起入口：整行可点 */
.more-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 12px;
  padding: 10px;
  border-radius: 6px;
  background: #eef2ff;
  color: #2563eb;
  font-size: 13px;
  text-align: center;
  line-height: 18px;
}

.hint-chev {
  width: 6px;
  height: 6px;
  border-right: 1.5px solid #2563eb;
  border-bottom: 1.5px solid #2563eb;
  transform: rotate(45deg) translate(-1px, -1px);
}

/* 等宽高亮（字段名 / 文件名 / 文件夹名） */
.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  background: #eef2f7;
  color: #1f4e79;
  border-radius: 3px;
  padding: 0 4px;
  font-size: 12px;
}

.mono-hl {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  background: rgba(31, 78, 121, 0.09);
  color: #1f4e79;
  border-radius: 3px;
  padding: 0 4px;
  font-size: 12px;
}

/* 字段说明块 */
.mono-box {
  background: #f3f5f9;
  border-radius: 6px;
  padding: 10px 12px;
  line-height: 1.8;
  word-break: break-word;
}

/* 输出规则：浅黄提示底（高频丢分信息） */
.warn-box {
  background: #fffbeb;
  border-left: 3px solid #f59e0b;
  border-radius: 6px;
  padding: 10px 12px;
  font-size: 13px;
  color: #78500a;
  line-height: 1.7;
  word-break: break-word;
  white-space: pre-wrap;
}

/* ══════════ 2. 评分标准 ══════════ */
.criteria-body {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.criteria-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 8px 10px;
  border-radius: 6px;
  background: #f8fafc;
}

.criteria-item-mark {
  flex-shrink: 0;
  font-size: 13px;
  color: #2563eb;
  line-height: 20px;
}

.criteria-item-desc {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: #374151;
  line-height: 20px;
  word-break: break-word;
}

.criteria-item-score {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 600;
  color: #d97706;
  line-height: 20px;
}

/* ══════════ 3. 代码作答区 ══════════ */
.answer-section {
  padding: 16px 0 16px 16px;
}

.answer-section .card-head {
  padding-right: 16px;
}

/* 代码容器：max-height 420px，内部纵向滚动 */
.code-scroll {
  max-height: 420px;
  background: #1e2530;
  border-radius: 8px;
  margin-right: 16px;
  box-sizing: border-box;
  /* 横向滚动：内容不换行，由 scroll-view 承载横向溢出 */
  white-space: nowrap;
}

.code-editor {
  padding: 10px 0;
  display: inline-block;
  min-width: 100%;
  box-sizing: border-box;
  vertical-align: top;
}

/* 代码行：行高固定 28px */
.code-line {
  display: flex;
  align-items: flex-start;
  min-height: 28px;
  line-height: 28px;
}

.line-num {
  flex-shrink: 0;
  width: 34px;
  padding-right: 8px;
  text-align: right;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 11px;
  line-height: 28px;
  color: #5c6b80;
}

.line-content {
  /* 不收缩：让长行撑开容器，交由 scroll-view 横向滚动，避免文字被裁掉 */
  flex: 0 0 auto;
  padding-right: 24px;
  line-height: 28px;
  white-space: pre;
}

.code-text {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 28px;
  color: #d6deeb;
}

/* 填空输入框：行内组件，不改变 28px 行高 */
.code-blank {
  display: inline-block;
  width: 108px;
  height: 22px;
  min-height: 22px;
  line-height: 22px;
  padding: 0 6px;
  margin: 0 2px;
  vertical-align: middle;
  box-sizing: border-box;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 12px;
  color: #ffd479;
  background: rgba(255, 212, 121, 0.12);
  border: none;
  border-bottom: 1px dashed #7c8aa5;
  border-radius: 3px;
}

/* 验证后的填空结果：仍是行内组件 */
.blank-result {
  display: inline-block;
  vertical-align: middle;
  max-width: 100%;
  padding: 1px 6px;
  margin: 0 2px;
  border-radius: 4px;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 20px;
  white-space: normal;
  word-break: break-all;
}

.blank-user-value {
  font-size: 12px;
  line-height: 20px;
}

.blank-ref-line {
  display: block;
  font-size: 11px;
  line-height: 16px;
  color: #9aa7b8;
}

.blank-ref-tag {
  font-size: 11px;
  color: #7c8aa5;
}

.blank-ref-ok {
  display: flex;
  align-items: center;
  gap: 3px;
  color: #4ade80;
}

/* 对勾：纯 CSS 矢量图标 */
.icon-check {
  flex-shrink: 0;
  width: 8px;
  height: 4px;
  border-left: 1.5px solid #4ade80;
  border-bottom: 1.5px solid #4ade80;
  transform: rotate(-45deg) translateY(-1px);
}

/* 答对：绿 */
.blank-correct {
  background: rgba(31, 157, 85, 0.18);
  color: #6ee7a0;
  border: 1px solid rgba(110, 231, 160, 0.4);
}

/* 答错：红 + 删除线 + 下方给参考答案 */
.blank-wrong {
  background: rgba(214, 69, 69, 0.18);
  color: #fca5a5;
  border: 1px solid rgba(252, 165, 165, 0.4);
}

.blank-wrong .blank-user-value {
  text-decoration: line-through;
}

/* 未填：红 */
.blank-empty {
  background: rgba(248, 113, 113, 0.2);
  color: #fca5a5;
  border: 1px solid rgba(252, 165, 165, 0.45);
}

.no-template-tip {
  font-size: 13px;
  color: #6b7280;
  line-height: 20px;
  padding: 16px 16px 16px 0;
}

/* ── 验证结果总分 ── */
.verify-summary {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
  margin: 12px 16px 0 0;
  padding: 10px 12px;
  border-radius: 6px;
  font-size: 13px;
  line-height: 20px;
}

.summary-pass {
  background: #e8f8ee;
  color: #1f9d55;
}

.summary-fail {
  background: #fff8e1;
  color: #b7791f;
}

.summary-score {
  font-size: 15px;
  font-weight: 600;
}

.summary-count {
  font-size: 12px;
  color: #6b7280;
}

/* ── 评分点明细 ── */
.point-list {
  margin: 10px 16px 0 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.point-row {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 7px 10px;
  border-radius: 6px;
  font-size: 13px;
  line-height: 19px;
}

.point-badge {
  flex-shrink: 0;
  font-size: 12px;
  font-weight: 600;
}

.point-desc {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.point-full {
  background: #e8f8ee;
  color: #1f9d55;
}

.point-part {
  background: #fff8e1;
  color: #b7791f;
}

.point-zero {
  background: #fdecec;
  color: #d64545;
}

.point-doc {
  background: #eef0f3;
  color: #6b7280;
}

/* ── 文档作答区 ── */
.sub-section-title {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #374151;
  line-height: 20px;
  margin: 16px 16px 8px 0;
}

.doc-section {
  margin-bottom: 4px;
}

.doc-area {
  width: 100%;
  min-height: 110px;
  box-sizing: border-box;
  padding: 10px 12px;
  margin-right: 16px;
  background: #f8fafc;
  border: 1px solid #e5e9f0;
  border-radius: 6px;
  font-size: 13px;
  line-height: 1.6;
  color: #1f2937;
}

/* ══════════ 4. 底部操作栏 ══════════ */
.action-bar {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
}

.action-bar .btn {
  flex: 1;
  min-height: 44px;
  line-height: 44px;
  border-radius: 8px;
  font-size: 15px;
  padding: 0 12px;
}

.btn-secondary {
  background: #ffffff;
  color: #374151;
  border: 1px solid #d7dce5;
}

.btn-primary {
  background: #2563eb;
  color: #ffffff;
}

.btn-primary[disabled] {
  background: #b6c3d8;
  color: #f2f5fa;
}

/* ── 评分结果（文档 / 混合题） ── */
.grade-result .grade-title {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #1f2937;
  line-height: 22px;
  margin-bottom: 8px;
}

.grade-result.bad .grade-title {
  color: #d64545;
}

.grade-mode {
  font-size: 12px;
  font-weight: 400;
  color: #6b7280;
}

.grade-item {
  font-size: 13px;
  color: #374151;
  line-height: 20px;
  padding: 4px 0;
  word-break: break-word;
}

/* ══════════ 5. 解析弹窗 ══════════ */
.analysis-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  box-sizing: border-box;
}

.analysis-modal {
  width: 92%;
  max-width: 720px;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 8px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.analysis-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  border-bottom: 1px solid #eef1f5;
}

.analysis-title {
  font-size: 15px;
  font-weight: 600;
  color: #1f2937;
  line-height: 22px;
}

.analysis-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f3f7;
}

.icon-close {
  width: 12px;
  height: 12px;
  position: relative;
}

.icon-close::before,
.icon-close::after {
  content: '';
  position: absolute;
  left: 0;
  top: 5px;
  width: 12px;
  height: 1.5px;
  background: #6b7280;
  border-radius: 1px;
}

.icon-close::before {
  transform: rotate(45deg);
}

.icon-close::after {
  transform: rotate(-45deg);
}

/* 内容区：超高时弹窗内部滚动 */
.analysis-body {
  flex: 1;
  min-height: 0;
  max-height: calc(70vh - 57px);
  padding: 16px;
  box-sizing: border-box;
}

.analysis-block {
  margin-bottom: 16px;
}

.analysis-block:last-child {
  margin-bottom: 0;
}

.analysis-label {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: #1f2937;
  line-height: 22px;
  margin-bottom: 6px;
}

.analysis-text {
  font-size: 13px;
  color: #374151;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.analysis-none {
  color: #9aa3b2;
}

/* 行内代码片段：灰底等宽 */
.inline-code {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 12px;
  background: #f1f3f7;
  color: #b03a3a;
  border-radius: 3px;
  padding: 1px 4px;
}

/* ══════════ 加载 / 空态 ══════════ */
.loading-wrap,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 80px 20px;
  min-height: 60vh;
  box-sizing: border-box;
}

.loading-spinner {
  width: 28px;
  height: 28px;
  border: 2px solid #dbe2ec;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 13px;
  color: #6b7280;
}

.empty-title {
  font-size: 15px;
  font-weight: 600;
  color: #1f2937;
}

.placeholder {
  font-size: 12px;
  color: #9aa3b2;
  text-align: center;
  line-height: 1.6;
}

.empty-state .btn {
  min-height: 44px;
  line-height: 44px;
  border-radius: 8px;
  font-size: 15px;
  padding: 0 32px;
}
