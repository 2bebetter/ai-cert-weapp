.page { min-height: 100vh; display: flex; flex-direction: column; }

/* 加载 */
.loading-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }

/* 任务区 */
.task-scroll { flex: 1; padding: 0 0 24px; }

.task-card { margin: 12px 16px; }
.task-title {
  font-size: 16px;
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
  line-height: 1.5;
}
.task-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}
.task-info { font-size: 12px; color: var(--text-3); }

.task-question {
  margin-top: 12px;
  padding: 12px;
  background: var(--bg);
  border-radius: var(--radius-sm);
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-2);
}

/* 评分标准 */
.criteria-section { margin-top: 12px; }
.criteria-header {
  display: flex;
  align-items: center;
  padding: 8px 0;
  font-size: 13px;
}
.criteria-title { flex: 1; }
.criteria-arrow { font-size: 10px; color: var(--text-4); }
.criteria-body {
  padding: 8px 12px;
  background: var(--bg);
  border-radius: var(--radius-sm);
}
.criteria-item {
  display: flex;
  gap: 8px;
  padding: 6px 0;
  font-size: 12px;
  border-bottom: 1px solid var(--border);
}
.criteria-item:last-child { border-bottom: none; }
.criteria-item-score {
  flex-shrink: 0;
  color: var(--primary);
  font-weight: 500;
  min-width: 30px;
}
.criteria-item-desc { color: var(--text-3); line-height: 1.5; }

/* 作答区 */
.answer-section { margin-top: 16px; }
.section-title {
  font-size: 14px;
  font-weight: 600;
  display: block;
  margin-bottom: 10px;
}
.sub-section-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-2);
  display: block;
  margin-bottom: 10px;
}

/* 代码编辑器 */
.code-scroll {
  background: #1e1e2e;
  border-radius: var(--radius-sm);
  max-height: 60vh;
  padding: 4px 0;
}
.code-editor { font-family: 'Menlo', 'Consolas', monospace; font-size: 12px; line-height: 1.6; }
.code-line { display: flex; min-height: 22px; }
.line-num {
  width: 32px;
  text-align: right;
  padding-right: 10px;
  color: #6c6c8a;
  flex-shrink: 0;
  user-select: none;
  font-size: 11px;
  line-height: 22px;
}
.line-content {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  white-space: pre;
}
.code-text {
  color: #cdd6f4;
  white-space: pre;
  line-height: 22px;
}
.code-blank {
  background: #313244;
  border: 1px solid #45475a;
  border-radius: 3px;
  color: #f5e0dc;
  padding: 1px 6px;
  min-width: 80px;
  font-size: 12px;
  height: 22px;
  line-height: 20px;
  box-sizing: border-box;
}

/* 验证后填空结果（行内容器 + 右下角答案标签） */
.blank-result {
  display: inline-block;
  position: relative;
  min-width: 80px;
  height: 22px;
  line-height: 20px;
  padding: 1px 22px 1px 6px;
  border: 2px solid #45475a;
  border-radius: 4px;
  box-sizing: border-box;
  font-size: 12px;
  color: #cdd6f4;
  vertical-align: baseline;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.blank-result.blank-correct { border-color: #4ade80; background: #1a3a2a; }
.blank-result.blank-wrong  { border-color: #f87171; background: #3a1a1a; }
.blank-result.blank-empty  { border-color: #fbbf24; background: #3a3010; }
.blank-user-value {
  display: inline;
  font-size: 12px;
  line-height: 20px;
  color: #cdd6f4;
}
.blank-user-value.value-empty { color: #f87171; font-weight: 500; }
.blank-ref-value {
  position: absolute;
  bottom: -1px;
  right: 3px;
  font-size: 8px;
  line-height: 1;
  color: #6c7086;
  padding: 0 2px;
  background: inherit;
  border-radius: 2px;
  z-index: 2;
}
.blank-result.blank-correct .blank-ref-value { color: #a6e3a1; }
.blank-result.blank-wrong .blank-ref-value  { color: #f9c2c2; }
.blank-result.blank-empty .blank-ref-value  { color: #fde68a; }

/* 验证结果条 */
.verify-summary {
  margin-top: 12px;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.verify-summary.summary-pass { background: #e8f8ee; }
.verify-summary.summary-fail { background: #fff8e1; }
.summary-count { font-size: 11px; color: var(--text-3); }

/* 解析弹窗 */
.analysis-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.analysis-modal {
  background: var(--card-bg);
  border-radius: var(--radius) var(--radius) 0 0;
  width: 100%;
  max-height: 65vh;
  display: flex;
  flex-direction: column;
}
.analysis-head {
  display: flex;
  align-items: center;
  padding: 16px 16px 12px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.analysis-title {
  font-size: 15px;
  font-weight: 600;
  flex: 1;
}
.analysis-close {
  font-size: 16px;
  color: var(--text-3);
  padding: 4px 8px;
}
.analysis-body {
  padding: 12px 16px 24px;
  flex: 1;
}
.analysis-block {
  margin-top: 12px;
}
.analysis-block:first-child { margin-top: 0; }
.analysis-label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 4px;
}
.analysis-answer {
  display: block;
  font-family: 'Menlo', 'Consolas', monospace;
  font-size: 12px;
  color: var(--primary);
  background: var(--bg);
  padding: 6px 8px;
  border-radius: var(--radius-sm);
  line-height: 1.5;
}
.analysis-text {
  display: block;
  font-size: 12px;
  color: var(--text-3);
  line-height: 1.6;
}
.code-blank-ref {
  color: #a6e3a1;
  background: #313244;
  border: 1px dashed #585b70;
  border-radius: 3px;
  padding: 1px 6px;
  font-size: 12px;
  line-height: 22px;
  margin: 0 2px;
}

.no-template-tip {
  padding: 12px;
  background: var(--bg);
  border-radius: var(--radius-sm);
  font-size: 13px;
  color: var(--text-3);
  text-align: center;
  margin-bottom: 12px;
}

/* 文档作答区 */
.doc-section {
  margin-bottom: 16px;
}
.doc-section .sub-section-title {
  margin-bottom: 8px;
}
.doc-area {
  width: 100%;
  min-height: 160px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px;
  font-size: 14px;
  line-height: 1.7;
  box-sizing: border-box;
}

.actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}
.actions .btn { flex: 1; }

.grade-result {
  margin-top: 12px;
  padding: 12px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  line-height: 1.6;
}
.grade-result.ok { background: #e8f8ee; }
.grade-result.bad { background: #ffe8e6; }
.grade-title {
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
}
.grade-mode { font-weight: 400; font-size: 11px; color: var(--text-3); }
.grade-item {
  padding: 4px 0;
  border-top: 1px solid rgba(0,0,0,0.08);
}

/* 参考答案（旧版，弃用保留） */
.reference-section { display: none; }