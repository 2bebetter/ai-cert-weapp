/* ══════════════════════════════════════════════════════════
   共享矢量图标库（纯 CSS，无 emoji、无图标字体、无外部依赖）
   由 inline SVG data-uri 绘制，随主题色静态生成。
   用法：<view class="ic ic-16 ic-pen-primary"></view>
   ══════════════════════════════════════════════════════════ */

.ic {
  display: inline-block;
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  vertical-align: -3px;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

/* 尺寸 */
.ic-12 { width: 12px; height: 12px; vertical-align: -2px; }
.ic-14 { width: 14px; height: 14px; vertical-align: -3px; }
.ic-16 { width: 16px; height: 16px; vertical-align: -3px; }
.ic-18 { width: 18px; height: 18px; vertical-align: -4px; }
.ic-20 { width: 20px; height: 20px; vertical-align: -4px; }
.ic-24 { width: 24px; height: 24px; vertical-align: -5px; }
.ic-32 { width: 32px; height: 32px; vertical-align: middle; }
.ic-40 { width: 40px; height: 40px; vertical-align: middle; }
.ic-48 { width: 48px; height: 48px; vertical-align: middle; }

/* 图标与文字并排时的通用行容器 */
.ic-row {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
}

